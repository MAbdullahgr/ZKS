# ZKS Store Management — Environment Variables
# Copy this file to .env and fill in real values.
# NEVER commit .env to git.

# ─── Database (PostgreSQL) ───────────────────────────────────────────────
# This works for BOTH local PostgreSQL and Neon (cloud) — the pg library
# auto-detects SSL from the connection string.
#
# OPTION A: Local PostgreSQL
#   1. Install PostgreSQL if you don't have it
#   2. Open psql as the postgres superuser and run:
#        CREATE DATABASE zks;
#        CREATE USER zks_user WITH PASSWORD 'your_password';
#        GRANT ALL PRIVILEGES ON DATABASE zks TO zks_user;
#        \c zks
#        GRANT ALL ON SCHEMA public TO zks_user;
#        \q
#   3. Use: postgresql://zks_user:your_password@localhost:5432/zks?schema=public
#
# OPTION B: Neon (cloud, free tier — for Vercel deployment)
#   1. Go to https://neon.tech and create a database
#   2. Copy the connection string (includes ?sslmode=require)
#   3. Paste it below
#
# >>> SET THIS TO YOUR ACTUAL CONNECTION STRING <<<
DATABASE_URL=postgresql://zks_user:your_password@localhost:5432/zks?schema=public

# ─── Auth ───────────────────────────────────────────────────────────────
# Generate with: openssl rand -hex 64
# MUST be at least 32 characters
JWT_SECRET=replace-with-64-char-random-hex-string-minimum

# ─── Cloudinary (file uploads) ──────────────────────────────────────────
# Get these from https://cloudinary.com — free tier
# Optional for local dev (file upload will just fail, but app runs)
CLOUDINARY_CLOUD_NAME=your-cloud-name
CLOUDINARY_API_KEY=your-api-key
CLOUDINARY_API_SECRET=your-api-secret

# ─── Upstash Redis (rate limiting) ──────────────────────────────────────
# Get these from https://upstash.com — free tier gives 10k commands/day
# Optional for local dev (rate limiting falls back to no-op if not set)
# REQUIRED for Vercel production
UPSTASH_REDIS_REST_URL=https://your-redis.upstash.io
UPSTASH_REDIS_REST_TOKEN=your-token

# ─── App config ─────────────────────────────────────────────────────────
NEXT_PUBLIC_APP_NAME=ZKS Store

# ─── Vercel Cron (optional but recommended for production) ──────────────
# Generate with: openssl rand -hex 32
# Vercel sends this as `Authorization: Bearer <token>` on every cron call.
# Without it, anyone could trigger your cron endpoints.
CRON_SECRET=replace-with-32-char-random-hex

# ─── Optional: FBR e-invoicing (Phase 6 — not yet implemented) ──────────
# FBR_ENVIRONMENT=sandbox
# FBR_POS_ID=
# FBR_NTN=
# FBR_SRN=
# FBR_API_KEY=

# ─── Timezone ───────────────────────────────────────────────────────────
# AUDIT-FIX C-18: Set the server timezone to Pakistan time. Without this,
# Vercel serverless functions run in UTC and every date-based report is
# off by 5 hours (PKT = UTC+5). Daily revenue reports won't match register
# close-out; monthly P&L includes/wrongly-excludes 5 hours at each month
# boundary; invoice numbers use UTC dates instead of PKT dates.
#
# This must ALSO be set in the Vercel dashboard (Project Settings → Environment
# Variables) — vercel.json doesn't set process.env directly. Set it in
# Production + Preview + Development environments.
TZ=Asia/Karachi

# ─── Email (Resend) ─────────────────────────────────────────────────────
# AUDIT-FIX C-17: Required for password-reset notifications, low-stock
# alerts, and payroll notifications. Without these, the app runs but no
# emails are sent. Sign up at https://resend.com (free tier: 100/day).
# The from-email must use a verified domain in Resend.
# RESEND_API_KEY=re_xxxxxxxxxxxx
# RESEND_FROM_EMAIL=ZKR Store <noreply@yourdomain.com>
